# Copy to .env and fill in. Never commit .env.
# Gnani (app.gnani.ai/voice → API keys). Header name for STT is x-api-key-id, TTS is X-API-Key-ID.
GNANI_API_KEY=
GNANI_STT_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_TTS_URL=wss://api.vachana.ai/api/v1/tts

# Evon v3.3 served by vLLM on the rented GPU (OpenAI-compatible)
VLLM_BASE_URL=https://<gpu-host>/v1
VLLM_API_KEY=
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B

# Hugging Face token (only on the GPU box, for downloading Evon weights)
HF_TOKEN=

# Backend runtime
ALLOWED_ORIGIN=http://localhost:3000
MAX_CONCURRENT_CALLS=1
MAX_CALL_SECONDS=240
DAILY_CALL_CAP=300
PER_IP_DAILY_CAP=5
LIVE_HOURS=20:00-23:00
DATABASE_PATH=./kalpakka.db
LOG_LEVEL=info

# Web (web/.env.local)
NEXT_PUBLIC_BACKEND_WS=ws://localhost:8000/call
NEXT_PUBLIC_BACKEND_HTTP=http://localhost:8000
