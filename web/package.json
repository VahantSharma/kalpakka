{
  "name": "kalpakka-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/build-worklet.mjs",
    "dev": "concurrently -k -n mock,web \"npm:mock\" \"next dev\"",
    "dev:web": "next dev",
    "mock": "node mock/server.ts",
    "prebuild": "node scripts/build-worklet.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.2",
    "rolldown": "1.2.16",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "ws": "8.22.1"
  }
}
