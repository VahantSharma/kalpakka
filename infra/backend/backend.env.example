# /etc/kalpakka/backend.env on the VM (chmod 600). Names only here; never commit values.
# Names match kalpakka.config.Settings (env names = field names, case-insensitive).

# Evon (live: the RunPod pod URL printed by `infra/gpu/runpod.py start`)
LLM_BASE_URL=https://<pod-id>-8080.proxy.runpod.net/v1
LLM_API_KEY=
LLM_MODEL=evon

# Gnani (Prisma v3 + Timbre v3)
GNANI_API_KEY=

# Browser origin(s) allowed to open /call (comma-separated). Must include the Vercel URL.
ALLOWED_ORIGINS=https://<web>.vercel.app

# Live hours (IST) and caps — values decided in P4.4/P0.4; these are the code defaults.
LIVE_HOURS=10:45-22:00
MAX_CONCURRENT_CALLS=1
CALLS_PER_DAY=200
CALLS_PER_IP_PER_DAY=5

# Set by the image already (shown for reference): DB_PATH, PRERENDER_DIR, TRUST_FORWARDED_FOR=true
